HOST=127.0.0.1
PORT=3001
# Prefer ADMIN_PASSWORD_HASH for production. Generate with:
# npm run admin:hash -- "your-long-admin-password"
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=change-this-dev-fallback
COOKIE_SECRET=change-this-too
COOKIE_SECURE=true
# Trust only loopback reverse proxies by default. Set to another Express trust
# proxy value only if the app is behind a different trusted proxy topology.
TRUST_PROXY=loopback
STORE_NAME=Plain Store
PUBLIC_STORE_URL=https://plainstore.net
PICKUP_LOCATION="299 Grand Falls, Conway, AR, 72032"
PICKUP_INSTRUCTIONS="Pickup is by appointment. Reply to your ready-for-pickup email if the timing no longer works."
ORDER_CONFIRMATION_MINUTES=30
CONTACT_VERIFICATION_DAYS=90
MAIL_FROM="Plain Store <orders@example.com>"
STORE_OWNER_EMAIL=owner@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=orders@example.com
SMTP_PASS=change-this
